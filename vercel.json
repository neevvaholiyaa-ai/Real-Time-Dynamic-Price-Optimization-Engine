{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://real-time-dynamic-price-optimization.onrender.com/api/:path*"
    },
    {
      "source": "/predict",
      "destination": "https://real-time-dynamic-price-optimization.onrender.com/predict"
    },
    {
      "source": "/health",
      "destination": "https://real-time-dynamic-price-optimization.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://real-time-dynamic-price-optimization.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://real-time-dynamic-price-optimization.onrender.com/openapi.json"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/frontend/script.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
